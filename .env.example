# Copy to .env and fill in values. Do not commit secrets.
#
# Paths match the vanilla lloesche layout:
#   host config  →  container /config
# BepInEx config tree:  /config/bepinex
#
# The manager writes installs under config/bepinex only. Do not mount
# data/bepinex — binding that tree blocks the Valheim image from renaming
# it during BepInEx merge.
#
# Bulky mods can be marked persistent: files live in
# config/bepinex/.persistent/<package>, with a symlink in plugins that
# bootstrap copies into the live tree without walking the files.
#
# Example when Valheim uses $HOME/valheim-server/{config,data}:

MOD_MANAGER_SECRET_KEY=replace-with-long-random-string
MOD_MANAGER_ADMIN_PASSWORD=changeme

# Valheim container DNS name on the shared Docker network (compose service or --name).
SUPERVISOR_URL=http://valheim:9001
# Do NOT use localhost from inside the manager container.
SUPERVISOR_USER=admin
SUPERVISOR_PASSWORD=
# On the Valheim image, auth is SUPERVISOR_HTTP_PASS. Leave empty here if Valheim has no auth.
SUPERVISOR_PROGRAM=valheim-server
CONTAINER_DISPLAY_NAME=valheim
TIMEZONE=UTC

# docker network ls  — or: docker inspect -f '{{json .NetworkSettings.Networks}}' <valheim-container>
VALHEIM_DOCKER_NETWORK=valheim-server_default

VALHEIM_BEPINEX_PATH=/home/user/valheim-server/config/bepinex
