# Copy to .env and fill in values. Do not commit secrets.
MOD_MANAGER_SECRET_KEY=replace-with-long-random-string
MOD_MANAGER_ADMIN_PASSWORD=changeme
SUPERVISOR_URL=http://host.docker.internal:9001
# If mod-manager shares a Compose network with the Valheim container, prefer:
# SUPERVISOR_URL=http://BabyGotBoar:9001
# On Linux without host.docker.internal, use the host LAN IP instead.
SUPERVISOR_USER=admin
SUPERVISOR_PASSWORD=
VALHEIM_BEPINEX_PATH=H:/Games/Valheim Server/Docker/config/bepinex
VALHEIM_LIVE_PLUGINS_PATH=H:/Games/Valheim Server/Docker/data/bepinex/BepInEx/plugins
